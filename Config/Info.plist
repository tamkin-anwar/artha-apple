<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only so the simulator can reach the local dev server over plain
	     http://localhost. Every real server address (arthaapp.com) is HTTPS
	     and gets no exception. -->
	<!-- Only standard HTTPS through Apple's networking and the Keychain,
	     which are exempt, so App Store Connect doesn't hold every build
	     at "Missing Compliance". -->
	<!-- Background refresh keeps bill reminders and budget alerts current
	     while the app is closed (ArthaApp's BackgroundRefresh). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>studio.anwarcreative.artha.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The Keychain group the sign-in token is shared through with the
	     widgets (see Shared/Keychain.swift). -->
	<key>ArthaKeychainGroup</key>
	<string>$(AppIdentifierPrefix)studio.anwarcreative.artha.shared</string>
	<!-- artha://add, artha://plan and so on: where widgets and the Control
	     Center button open the app to. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>studio.anwarcreative.artha</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>artha</string>
			</array>
		</dict>
	</array>
	<!-- "Open in Artha" for a bank statement (a PDF or CSV) from Files, Mail
	     or the share sheet. Alternate rank, so Artha never becomes anyone's
	     default PDF viewer; opened in place, so the app reads the original
	     and never keeps a copy (AppSession.open hands it to Activity). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bank statement</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.comma-separated-values-text</string>
				<string>studio.anwarcreative.artha.ofx</string>
				<string>studio.anwarcreative.artha.qif</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>studio.anwarcreative.artha.ofx</string>
			<key>UTTypeDescription</key>
			<string>OFX bank statement</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ofx</string>
					<string>qfx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-ofx</string>
					<string>application/vnd.intu.qfx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>studio.anwarcreative.artha.qif</string>
			<key>UTTypeDescription</key>
			<string>QIF bank statement</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qif</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/qif</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
